# Copy to .env and fill in the real values (get them from Obada through a
# private channel). Never commit real values to this file or to git.

# Supabase pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection (port 5432). Not used at runtime, but prisma/schema.prisma
# declares directUrl = env("DIRECT_URL"), so Prisma CLI commands expect it to exist.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
JWT_SECRET="change-me-long-random-string"
PORT=3001

# Email. Brevo is used first when set (works on Render). Gmail SMTP is the local
# fallback. Leave both empty to print codes in the server log instead (dev mode).
BREVO_API_KEY=""
MAIL_FROM=""
MAIL_FROM_NAME="Nexus"
# Gmail + App Password: myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Number of proxy hops in front of the server (for rate limiting by client IP).
# Default 1 (Render). Only change it if the rate-limit log shows a proxy IP.
# TRUST_PROXY=1

# Claude API for the AI page (console.anthropic.com). Leave empty locally to
# turn AI off: insight/chat answer 503, reports show numbers without AI text.
ANTHROPIC_API_KEY=""
# Model for all AI features. Default claude-haiku-5-5. See the README for other options.
# AI_MODEL="claude-haiku-5-5"
# Server-side fallbacks are off by default (Haiku 5.5 has none). "on" only
# takes effect with an Opus/Sonnet 5.5 model.
# AI_FALLBACKS="on"

# Weekly summary emails (users opt in under Profile). On by default; "off"
# stops the job that checks every 15 minutes.
# WEEKLY_SUMMARY="off"
