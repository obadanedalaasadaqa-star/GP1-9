# Copy to .env and fill in the real values (get them from Obada through a
# private channel). Never commit real values to this file or to git.

# Supabase pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection (port 5432). Not used at runtime, but prisma/schema.prisma
# declares directUrl = env("DIRECT_URL"), so Prisma CLI commands expect it to exist.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# 32+ random characters. The server refuses to start on Render or in production otherwise.
JWT_SECRET="change-me-long-random-string"
PORT=3001

# Email. Brevo is used first when set (works on Render). Gmail SMTP is the local
# fallback. Leave both empty to print codes in the server log instead (dev mode).
BREVO_API_KEY=""
MAIL_FROM=""
MAIL_FROM_NAME="Nexus"
# Gmail + App Password: myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Number of proxy hops in front of the server (for rate limiting by client IP).
# Default 1 (Render). Only change it if the rate-limit log shows a proxy IP.
# To check it (the "[rate-limit] login blocked ip=" line is only written when
# a request is blocked, so force one block):
#   1. Pick an address that has no account, e.g. test_proxycheck@nexus.test
#      (an unknown email always fails, so no account is touched, no email sent).
#   2. Send 11 POST /api/auth/login with it, any password, and the header
#      X-Forwarded-For: 203.0.113.7. The first 10 get 401, the 11th 429.
#   3. Read the "[rate-limit] login blocked ip=..." line in the server log.
#   4. It must show your real public IP. 203.0.113.7 means TRUST_PROXY is too
#      high (spoofable); a private/Render-internal address means too low.
#   5. Side effect: login from that IP is blocked for 15 minutes for every
#      account (the demo account too). Restarting the server clears it.
# TRUST_PROXY=1

# Claude API for the AI page (console.anthropic.com). Leave empty locally to
# turn AI off: insight/chat answer 503, reports show numbers without AI text.
ANTHROPIC_API_KEY=""
# Model for all AI features. Default claude-haiku-5-5. See the README for other options.
# AI_MODEL="claude-haiku-5-5"
# Server-side fallbacks are off by default (Haiku 5.5 has none). "on" only
# takes effect with an Opus/Sonnet 5.5 model.
# AI_FALLBACKS="on"

# Weekly summary emails (users opt in under Profile). On by default; "off"
# stops the job that checks every 15 minutes.
# WEEKLY_SUMMARY="off"

# Two-step sign-in (users opt in under Profile). "off" is the emergency switch
# back to password-only login for everyone (e.g. during a mail outage).
# LOGIN_2FA="off"

# Demo account for `npm run demo:reset -- <email> --yes` (the reset only runs
# when the email equals this). Keep the real address only in your own .env.
# DEMO_EMAIL=""

# Continue with Google: the iOS OAuth client ID(s) from Google Cloud,
# comma-separated. Kept out of git: set it in your local .env and in Render's
# environment only. Empty = Google sign-in answers 503.
GOOGLE_CLIENT_IDS=""
