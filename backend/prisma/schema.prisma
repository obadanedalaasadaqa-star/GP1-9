generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  firstName     String?
  lastName      String?
  phone         String?  @unique
  emailVerified Boolean  @default(false)
  serialNumber  String   @unique
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipts          Receipt[]
  verificationCodes VerificationCode[]

  @@map("nexus_users")
}

// One active code per user per type ("email" now, "phone" later)
model VerificationCode {
  id         String   @id @default(uuid())
  userId     String
  type       String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("nexus_verification_codes")
}

// Stores that send receipts. apiKeyHash = SHA-256 of the store key.
model Store {
  id         String   @id @default(uuid())
  name       String
  category   String
  apiKeyHash String   @unique
  createdAt  DateTime @default(now())

  receipts Receipt[]

  @@map("nexus_stores")
}

// Receipts (storeId is set when a store sent it)
model Receipt {
  id          String   @id @default(uuid())
  userId      String
  storeId     String?
  storeName   String
  category    String
  totalAmount Float
  items       Json
  lineItems   Json?
  pointsEarned Int     @default(0)
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "nexus_receipts_user_created_idx")
  @@map("nexus_receipts")
}
