generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  firstName     String?
  lastName      String?
  phone         String?  @unique
  emailVerified Boolean  @default(false)
  serialNumber  String   @unique
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipts          Receipt[]
  verificationCodes VerificationCode[]

  @@map("nexus_users")
}

// One active code per user per type ("email" now, "phone" later)
model VerificationCode {
  id         String   @id @default(uuid())
  userId     String
  type       String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("nexus_verification_codes")
}

// Future: receipt model (Phase 2)
model Receipt {
  id          String   @id @default(uuid())
  userId      String
  storeName   String
  category    String
  totalAmount Float
  items       Json
  pointsEarned Int     @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nexus_receipts")
}
