generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  firstName     String?
  lastName      String?
  phone         String?  @unique
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  serialNumber  String   @unique
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Budget alerts and weekly summary. The last two are internal (never returned).
  budgetAlertEmails     Boolean @default(true)
  weeklySummaryEmails   Boolean @default(false)
  tzOffsetMinutes       Int     @default(180)
  weeklySummarySentWeek String?

  receipts          Receipt[]
  verificationCodes VerificationCode[]
  aiInsight         AiInsight?
  aiUsage           AiUsage[]
  aiReports         AiReport[]
  budgets           Budget[]
  budgetAlerts      BudgetAlert[]

  @@map("nexus_users")
}

// One active code per user per type ("email", "phone" or "login").
// SMS codes in Twilio mode store codeHash = 'twilio:<Verification SID>'.
// sentTo: where the code went (normalized number for SMS, NULL for email).
model VerificationCode {
  id         String   @id @default(uuid())
  userId     String
  type       String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  sentTo     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("nexus_verification_codes")
}

// Stores that send receipts. apiKeyHash = SHA-256 of the store key.
model Store {
  id         String   @id @default(uuid())
  name       String
  category   String
  apiKeyHash String   @unique
  createdAt  DateTime @default(now())

  receipts Receipt[]

  @@map("nexus_stores")
}

// Receipts (storeId is set when a store sent it)
model Receipt {
  id          String   @id @default(uuid())
  userId      String
  storeId     String?
  storeName   String
  category    String
  totalAmount Float
  items       Json
  lineItems   Json?
  pointsEarned Int     @default(0)
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "nexus_receipts_user_created_idx")
  @@map("nexus_receipts")
}

// AI insight cache, one row per user. inputHash = hash of the numbers sent.
model AiInsight {
  userId       String   @id
  inputHash    String
  summary      String
  tip          String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nexus_ai_insights")
}

// Daily AI use per user (UTC day). count = requests that reached Claude (or emails sent).
model AiUsage {
  userId       String
  day          DateTime @db.Date
  kind         String
  count        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, kind])
  @@map("nexus_ai_usage")
}

// AI text of a spending report (numbers are never stored).
model AiReport {
  userId       String
  rangeKey     String
  inputHash    String
  headline     String
  narrative    String
  tips         Json     @default("[]")
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, rangeKey])
  @@map("nexus_ai_reports")
}

// Monthly budget per category (the same amount every month).
model Budget {
  userId       String
  category     String
  monthlyLimit Float
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("nexus_budgets")
}

// Budget alerts sent: each level (80, 100) at most once per category per month.
model BudgetAlert {
  userId       String
  category     String
  month        String
  level        Int      @db.SmallInt
  spent        Float
  monthlyLimit Float
  receiptId    String?
  emailed      Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, month, level])
  @@map("nexus_budget_alerts")
}
